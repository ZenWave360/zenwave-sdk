{{!-- from-transition without id: the entities are located by a developer-supplied lookup (never findAll / new instance) --}}
{{~else if (and _entity method.transition.from (isFalsy method.paramId) method.returnType method.returnTypeIsOptional)}}
    // TODO CUSTOM_REQUIRED: load the {{_entity.className}} this transition applies to{{#if method.parameter}}, e.g. by a correlation key in the input{{/if}}
    Optional<{{_entity.className}}> found{{_entity.className}} = Optional.empty();
    var {{_entity.instanceName}} = found{{_entity.className}}.map(existing{{_entity.className}} -> {
        {{~entityServiceTransitionsClassName _entity}}.{{transitionMethodName method}}(existing{{_entity.className}});
        {{~#if method.parameter}}
        {{asInstanceName service.name}}Mapper.update(existing{{_entity.className}}, {{{mapperInputCallSignature method.parameter}}});
        {{~/if}}
		{{~#if method.transition.to}}
		existing{{_entity.className}}.set{{asJavaTypeName _entity.options.lifecycle.field}}({{entityLifecycleFieldType _entity}}.{{method.transition.to}});
        {{~/if}}
        return existing{{_entity.className}};
    })
    .map({{_entity.instanceName}}Repository::save)
    {{~#unless (eq _entity.name method.returnType)}}
    .map({{asInstanceName service.name}}Mapper::as{{returnType}})
    {{~/unless}}
    ;
    {{~> (partial '../withEvents')}}
    return {{_entity.instanceName}};
